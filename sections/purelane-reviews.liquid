<section id="reviews" class="purelane-reviews">

  <div class="purelane-reviews__header">

    <p class="purelane-reviews__eyebrow">
      {{ section.settings.eyebrow }}
    </p>

    <div class="purelane-reviews__stats">

      <span>
        ★★★★★
      </span>

      <strong>
        {{ section.settings.rating }}
      </strong>

      <small>
        {{ section.settings.review_count }}
      </small>

    </div>

    <p class="purelane-reviews__homes">
      Loved by <strong>{{ section.settings.homes }}</strong> homes
    </p>

  </div>


  <div
    class="purelane-reviews__rail"
    aria-label="Customer reviews"
  >

    <div class="purelane-reviews__track">

      {% for block in section.blocks %}

        <article
          class="purelane-review"
          {{ block.shopify_attributes }}
        >

          <div class="purelane-review__stars">
            ★★★★★
          </div>


          <h3>
            {{ block.settings.title }}
          </h3>


          <p>
            {{ block.settings.review }}
          </p>


          <div class="purelane-review__person">

            <span class="purelane-review__check">
              ✓
            </span>

            <strong>
              {{ block.settings.name }}
            </strong>

            {% if block.settings.product != blank %}

              <span>
                · {{ block.settings.product }}
              </span>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

  .purelane-reviews {

    padding: 80px 0;

    background: #26382f;

    color: #f4f0e8;

    overflow: hidden;
  }


  .purelane-reviews__header {

    padding: 0 5%;

    text-align: center;

    margin-bottom: 40px;
  }


  .purelane-reviews__eyebrow {

    margin: 0 0 18px;

    font-size: 13px;

    letter-spacing: .15em;

    text-transform: uppercase;

    opacity: .7;
  }


  .purelane-reviews__stats {

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 12px;

    flex-wrap: wrap;
  }


  .purelane-reviews__stats span {

    letter-spacing: 2px;

    font-size: 18px;
  }


  .purelane-reviews__stats strong {

    font-size: 24px;
  }


  .purelane-reviews__stats small {

    font-size: 13px;

    opacity: .7;
  }


  .purelane-reviews__homes {

    margin: 12px 0 0;

    font-size: 14px;

    opacity: .75;
  }


  .purelane-reviews__homes strong {

    color: white;
  }


  .purelane-reviews__rail {

    overflow-x: auto;

    padding: 5px 5% 20px;

    scrollbar-width: thin;

    scroll-snap-type: x mandatory;
  }


  .purelane-reviews__track {

    display: flex;

    gap: 16px;

    width: max-content;
  }


  .purelane-review {

    width: 340px;

    padding: 28px;

    background: rgba(255,255,255,.09);

    border: 1px solid rgba(255,255,255,.16);

    border-radius: 18px;

    scroll-snap-align: start;

    box-sizing: border-box;
  }


  .purelane-review__stars {

    margin-bottom: 18px;

    font-size: 16px;

    letter-spacing: 2px;
  }


  .purelane-review h3 {

    margin: 0;

    font-size: 21px;

    font-weight: 500;

    line-height: 1.3;
  }


  .purelane-review > p {

    min-height: 105px;

    margin: 15px 0 22px;

    font-size: 14px;

    line-height: 1.65;

    opacity: .78;
  }


  .purelane-review__person {

    display: flex;

    align-items: center;

    gap: 6px;

    flex-wrap: wrap;

    font-size: 12px;
  }


  .purelane-review__person > span:last-child {

    opacity: .6;
  }


  .purelane-review__check {

    width: 20px;

    height: 20px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 50%;

    background: #f4f0e8;

    color: #26382f;

    font-weight: bold;
  }


  .purelane-review:focus-within {

    outline: 2px solid #f4f0e8;

    outline-offset: 4px;
  }


  @media screen and (max-width: 749px) {

    .purelane-reviews {

      padding: 60px 0;
    }


    .purelane-review {

      width: 82vw;

      max-width: 340px;

      padding: 23px;
    }


    .purelane-review > p {

      min-height: auto;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .purelane-reviews__rail {

      scroll-behavior: auto;
    }

  }

</style>


{% schema %}

{
  "name": "Purelane Reviews",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "That's what they said"
    },

    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },

    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "from 8,000+ reviews"
    },

    {
      "type": "text",
      "id": "homes",
      "label": "Homes",
      "default": "12 lakh+"
    }

  ],

  "blocks": [

    {
      "type": "review",
      "name": "Review",

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },

        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },

        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Anita"
        },

        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Laundry detergent"
        }

      ]
    }

  ],

  "presets": [

    {
      "name": "Purelane Reviews",

      "blocks": [

        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "review": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "name": "Anita",
            "product": "Laundry detergent"
          }
        },

        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "review": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "name": "Priya",
            "product": "Dishwash gel"
          }
        },

        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "review": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "name": "Sunita",
            "product": "Liquid handwash"
          }
        },

        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "review": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "name": "Rohit S.",
            "product": "Floor cleaner"
          }
        },

        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "review": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "name": "Verified buyer",
            "product": "Tap cleaner"
          }
        }

      ]
    }

  ]

}

{% endschema %}