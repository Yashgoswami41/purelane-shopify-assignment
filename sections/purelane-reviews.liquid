<section
  id="reviews"
  class="purelane-reviews"
  aria-labelledby="purelane-reviews-title"
>
  <div class="purelane-reviews__header">

    <div>
      <p class="purelane-reviews__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h2 id="purelane-reviews-title">
        {{ section.settings.heading }}
      </h2>
    </div>

    <div class="purelane-reviews__stats">
      <div>
        <span class="stars" aria-label="{{ section.settings.rating }} out of 5 stars">
          ★★★★★
        </span>
        <strong>{{ section.settings.rating }}</strong>
        <span>{{ section.settings.review_count }}</span>
      </div>

      <div>
        Loved by <strong>{{ section.settings.homes }}</strong> homes
      </div>
    </div>

  </div>


  <div
    class="purelane-reviews__rail"
    aria-label="Customer reviews"
  >
    <div class="purelane-reviews__track">

      {% for block in section.blocks %}
        <article
          class="purelane-review-card"
          {{ block.shopify_attributes }}
        >

          <div class="stars" aria-label="5 out of 5 stars">
            ★★★★★
          </div>

          <h3>
            {{ block.settings.title }}
          </h3>

          <p>
            {{ block.settings.review }}
          </p>

          <div class="purelane-review-card__customer">
            <span class="check">✓</span>

            <strong>
              {{ block.settings.customer }}
            </strong>

            <span>
              · {{ block.settings.product }}
            </span>
          </div>

        </article>
      {% endfor %}

      {% comment %}
        Duplicate the cards so the horizontal animation can loop smoothly.
      {% endcomment %}

      {% for block in section.blocks %}
        <article
          class="purelane-review-card"
          aria-hidden="true"
        >

          <div class="stars">
            ★★★★★
          </div>

          <h3>
            {{ block.settings.title }}
          </h3>

          <p>
            {{ block.settings.review }}
          </p>

          <div class="purelane-review-card__customer">
            <span class="check">✓</span>

            <strong>
              {{ block.settings.customer }}
            </strong>

            <span>
              · {{ block.settings.product }}
            </span>
          </div>

        </article>
      {% endfor %}

    </div>
  </div>
</section>


<style>
  .purelane-reviews {
    background: #f4f0e8;
    padding: 70px 0;
    overflow: hidden;
  }

  .purelane-reviews__header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
  }

  .purelane-reviews__eyebrow {
    margin: 0 0 8px;
    font-size: 13px;
    letter-spacing: .15em;
    text-transform: uppercase;
    opacity: .6;
  }

  .purelane-reviews h2 {
    margin: 0;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -.04em;
  }

  .purelane-reviews__stats {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .purelane-reviews__stats > div {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .stars {
    letter-spacing: 2px;
    font-size: 14px;
  }

  .purelane-reviews__rail {
    margin-top: 45px;
    overflow: hidden;
  }

  .purelane-reviews__track {
    display: flex;
    width: max-content;
    gap: 18px;
    animation: purelaneReviewsScroll 35s linear infinite;
  }

  .purelane-review-card {
    width: 310px;
    min-height: 205px;
    padding: 24px;
    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(38, 56, 47, .12);
    border-radius: 18px;
    flex-shrink: 0;
  }

  .purelane-review-card h3 {
    margin: 14px 0 9px;
    font-size: 19px;
    font-weight: 500;
  }

  .purelane-review-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: .78;
  }

  .purelane-review-card__customer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 12px;
  }

  .purelane-review-card__customer > span:last-child {
    opacity: .6;
  }

  .check {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #26382f;
    color: white;
    font-size: 11px;
  }

  @keyframes purelaneReviewsScroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  .purelane-reviews__track:hover,
  .purelane-reviews__track:focus-within {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .purelane-reviews__track {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    .purelane-reviews {
      padding: 55px 0;
    }

    .purelane-reviews__header {
      display: block;
      padding: 0 20px;
    }

    .purelane-reviews__stats {
      margin-top: 22px;
      gap: 12px;
    }

    .purelane-review-card {
      width: 280px;
    }
  }
</style>


{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real homes. Real results."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes",
      "label": "Homes count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "customer",
          "label": "Customer",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Works like a charm",
            "review": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.",
            "customer": "Anita",
            "product": "Laundry detergent"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "review": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "customer": "Priya",
            "product": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "review": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "customer": "Sunita",
            "product": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "review": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "customer": "Rohit S.",
            "product": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "review": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "customer": "Verified buyer",
            "product": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}