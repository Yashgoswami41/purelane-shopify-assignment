<section id="combos" class="purelane-combos">

  <div class="purelane-combos__header">

    <p>{{ section.settings.eyebrow }}</p>

    <h2>{{ section.settings.heading }}</h2>

    <div class="purelane-combos__rule">
      <span></span>
      <span>✦</span>
      <span></span>
    </div>

    <p class="purelane-combos__intro">
      {{ section.settings.description }}
    </p>

  </div>


  <div class="purelane-combos__rail">

    {% for block in section.blocks %}

      <article
        class="purelane-combo"
        {{ block.shopify_attributes }}
      >

        <div class="purelane-combo__top">

          {% if block.settings.badge != blank %}
            <span class="purelane-combo__badge">
              {{ block.settings.badge }}
            </span>
          {% endif %}

          {% if block.settings.saving != blank %}
            <span class="purelane-combo__saving">
              {{ block.settings.saving }}
            </span>
          {% endif %}

          <div class="purelane-combo__products">

            {% if block.settings.product_1 != blank %}
              <div class="purelane-combo__product">
                {% if block.settings.product_1.featured_image %}
                  {{
                    block.settings.product_1.featured_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.product_1.title
                  }}
                {% endif %}

                <span>
                  {{ block.settings.product_1.title }}
                </span>
              </div>
            {% endif %}


            <span class="purelane-combo__plus">+</span>


            {% if block.settings.product_2 != blank %}
              <div class="purelane-combo__product">
                {% if block.settings.product_2.featured_image %}
                  {{
                    block.settings.product_2.featured_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.product_2.title
                  }}
                {% endif %}

                <span>
                  {{ block.settings.product_2.title }}
                </span>
              </div>
            {% endif %}


            {% if block.settings.product_3 != blank %}

              <span class="purelane-combo__plus">+</span>

              <div class="purelane-combo__product">

                {% if block.settings.product_3.featured_image %}
                  {{
                    block.settings.product_3.featured_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      alt: block.settings.product_3.title
                  }}
                {% endif %}

                <span>
                  {{ block.settings.product_3.title }}
                </span>

              </div>

            {% endif %}

          </div>

        </div>


        <div class="purelane-combo__body">

          <h3>
            {{ block.settings.title }}
          </h3>

          <div class="purelane-combo__count">
            {{ block.settings.count }}
          </div>

          <p>
            {{ block.settings.description }}
          </p>


          <div class="purelane-combo__price">

            <strong>
              {{ block.settings.price }}
            </strong>

            {% if block.settings.compare_price != blank %}
              <s>
                {{ block.settings.compare_price }}
              </s>
            {% endif %}

            {% if block.settings.saving != blank %}
              <em>
                {{ block.settings.saving }}
              </em>
            {% endif %}

          </div>


          <small>
            Inclusive of all taxes · COD available
          </small>


          <a
            href="#bundles"
            class="purelane-combo__button"
          >
            Shop bundle →
          </a>

        </div>

      </article>

    {% endfor %}

  </div>


  <p class="purelane-combos__swipe">
    ← Swipe for more combos →
  </p>

</section>


<style>

  .purelane-combos {
    padding: 85px 5%;
    background: #f4f0e8;
    overflow: hidden;
  }


  .purelane-combos__header {
    max-width: 800px;
    margin: 0 auto 45px;
    text-align: center;
  }


  .purelane-combos__header > p:first-child {
    margin: 0 0 10px;
    font-size: 13px;
    letter-spacing: .15em;
    text-transform: uppercase;
    opacity: .6;
  }


  .purelane-combos h2 {
    margin: 0;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -.04em;
  }


  .purelane-combos__rule {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin: 20px 0;
  }


  .purelane-combos__rule span:first-child,
  .purelane-combos__rule span:last-child {
    width: 70px;
    height: 1px;
    background: rgba(38, 56, 47, .25);
  }


  .purelane-combos__intro {
    max-width: 650px;
    margin: auto;
    line-height: 1.6;
    opacity: .7;
  }


  .purelane-combos__rail {
    max-width: 1400px;
    margin: auto;

    display: flex;
    gap: 18px;

    overflow-x: auto;
    padding-bottom: 15px;

    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }


  .purelane-combo {
    flex: 0 0 390px;

    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(38, 56, 47, .12);
    border-radius: 20px;

    overflow: hidden;

    scroll-snap-align: start;
  }


  .purelane-combo__top {
    position: relative;

    padding: 25px;

    background: #e8eee4;
  }


  .purelane-combo__badge {
    position: absolute;
    top: 15px;
    left: 15px;

    padding: 7px 11px;

    background: #26382f;
    color: white;

    border-radius: 999px;
    font-size: 11px;
  }


  .purelane-combo__saving {
    position: absolute;
    top: 15px;
    right: 15px;

    font-size: 12px;
    opacity: .7;
  }


  .purelane-combo__products {
    min-height: 190px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding-top: 25px;
  }


  .purelane-combo__product {
    width: 90px;

    text-align: center;
  }


  .purelane-combo__product img {
    width: 75px;
    height: 75px;

    object-fit: contain;

    display: block;

    margin: auto auto 8px;
  }


  .purelane-combo__product span {
    display: block;

    font-size: 11px;
    line-height: 1.3;
  }


  .purelane-combo__plus {
    font-size: 20px;
    opacity: .45;
  }


  .purelane-combo__body {
    padding: 25px;
  }


  .purelane-combo__body h3 {
    margin: 0;

    font-size: 25px;
    font-weight: 500;
  }


  .purelane-combo__count {
    margin-top: 5px;

    font-size: 12px;
    opacity: .55;
  }


  .purelane-combo__body p {
    min-height: 72px;

    margin: 15px 0;

    font-size: 13px;
    line-height: 1.6;
    opacity: .75;
  }


  .purelane-combo__price {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }


  .purelane-combo__price strong {
    font-size: 23px;
  }


  .purelane-combo__price s {
    font-size: 14px;
    opacity: .5;
  }


  .purelane-combo__price em {
    font-size: 12px;
    font-style: normal;
    opacity: .75;
  }


  .purelane-combo__body small {
    display: block;

    margin-top: 8px;

    font-size: 11px;
    opacity: .55;
  }


  .purelane-combo__button {
    display: block;

    margin-top: 18px;

    padding: 12px 18px;

    border: 1px solid #26382f;
    border-radius: 999px;

    text-align: center;

    color: #26382f;
    text-decoration: none;

    transition:
      background .2s ease,
      color .2s ease;
  }


  .purelane-combo__button:hover {
    background: #26382f;
    color: white;
  }


  .purelane-combo__button:focus-visible {
    outline: 3px solid #587c67;
    outline-offset: 3px;
  }


  .purelane-combos__swipe {
    margin: 20px 0 0;

    text-align: center;

    font-size: 12px;
    opacity: .55;
  }


  @media screen and (max-width: 749px) {

    .purelane-combos {
      padding: 60px 20px;
    }

    .purelane-combo {
      flex-basis: 82vw;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .purelane-combos__rail {
      scroll-behavior: auto;
    }

  }

</style>


