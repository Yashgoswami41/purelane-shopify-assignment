<section id="shop" class="purelane-shop">

  <div class="purelane-shop__header">
    <p>{{ section.settings.eyebrow }}</p>

    <h2>{{ section.settings.heading }}</h2>

    <div class="purelane-shop__divider">
      <span></span>
      <span>✦</span>
      <span></span>
    </div>
  </div>


  {% if section.settings.collection != blank %}

    <div class="purelane-products">

      {% for product in section.settings.collection.products
        limit: section.settings.products_to_show
      %}

        <article class="purelane-product-card">

          <a
            href="{{ product.url }}"
            class="purelane-product-card__image"
          >

            {% if product.featured_image %}

              {{
                product.featured_image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '300,450,600',
                  alt: product.title
              }}

            {% else %}

              <div class="purelane-product-card__no-image">
                No image
              </div>

            {% endif %}


            {% unless product.available %}
              <span class="purelane-product-card__badge">
                Sold out
              </span>
            {% endunless %}

          </a>


          <div class="purelane-product-card__body">

            <h3>
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>


            <div class="purelane-product-card__rating">
              ★ 4.8
            </div>


            <div class="purelane-product-card__price">

              <strong>
                {{ product.price | money }}
              </strong>

              {% if product.compare_at_price > product.price %}

                <s>
                  {{ product.compare_at_price | money }}
                </s>

                <span>
                  {{ product.compare_at_price
                    | minus: product.price
                    | times: 100.0
                    | divided_by: product.compare_at_price
                    | round
                  }}% off
                </span>

              {% endif %}

            </div>


            {% if product.available %}

              <form
                method="post"
                action="/cart/add"
                class="purelane-product-card__form"
              >

                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                >

                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                >

                <button type="submit">
                  Add to cart →
                </button>

              </form>

            {% else %}

              <button
                type="button"
                disabled
                class="purelane-product-card__soldout"
              >
                Sold out
              </button>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  {% else %}

    <div class="purelane-shop__empty">
      Select a collection to display products.
    </div>

  {% endif %}

</section>


<style>

  .purelane-shop {
    padding: 85px 5%;
    background: #f4f0e8;
  }


  .purelane-shop__header {
    max-width: 1400px;
    margin: 0 auto 45px;
    text-align: center;
  }


  .purelane-shop__header p {
    margin: 0 0 10px;
    font-size: 13px;
    letter-spacing: .15em;
    text-transform: uppercase;
    opacity: .6;
  }


  .purelane-shop__header h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1;
    font-weight: 500;
    letter-spacing: -.045em;
  }


  .purelane-shop__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 20px;
  }


  .purelane-shop__divider span:first-child,
  .purelane-shop__divider span:last-child {
    width: 70px;
    height: 1px;
    background: rgba(38, 56, 47, .25);
  }


  .purelane-shop__divider span:nth-child(2) {
    font-size: 18px;
  }


  .purelane-products {
    max-width: 1400px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }


  .purelane-product-card {
    background: rgba(255, 255, 255, .72);
    border: 1px solid rgba(38, 56, 47, .12);
    border-radius: 18px;
    overflow: hidden;
  }


  .purelane-product-card__image {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #e9eee5;
    overflow: hidden;
  }


  .purelane-product-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    padding: 25px;

    transition: transform .25s ease;
  }


  .purelane-product-card:hover
  .purelane-product-card__image img {
    transform: scale(1.04);
  }


  .purelane-product-card__no-image {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 14px;
    opacity: .55;
  }


  .purelane-product-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;

    padding: 7px 10px;

    border-radius: 999px;
    background: #26382f;
    color: white;

    font-size: 12px;
  }


  .purelane-product-card__body {
    padding: 20px;
  }


  .purelane-product-card h3 {
    margin: 0;
    min-height: 48px;

    font-size: 17px;
    line-height: 1.35;
    font-weight: 500;
  }


  .purelane-product-card h3 a {
    color: inherit;
    text-decoration: none;
  }


  .purelane-product-card__rating {
    margin-top: 10px;
    font-size: 13px;
    opacity: .7;
  }


  .purelane-product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;

    margin-top: 10px;

    flex-wrap: wrap;
  }


  .purelane-product-card__price strong {
    font-size: 20px;
  }


  .purelane-product-card__price s {
    opacity: .5;
    font-size: 14px;
  }


  .purelane-product-card__price span {
    font-size: 12px;
    opacity: .75;
  }


  .purelane-product-card__form {
    margin-top: 15px;
  }


  .purelane-product-card button {
    width: 100%;
    min-height: 44px;

    border: 1px solid #26382f;
    border-radius: 999px;

    background: transparent;
    color: #26382f;

    cursor: pointer;

    font: inherit;

    transition:
      background .2s ease,
      color .2s ease;
  }


  .purelane-product-card button:hover {
    background: #26382f;
    color: white;
  }


  .purelane-product-card button:focus-visible {
    outline: 3px solid #587c67;
    outline-offset: 3px;
  }


  .purelane-product-card__soldout {
    margin-top: 15px;
    opacity: .5;
    cursor: not-allowed !important;
  }


  .purelane-product-card__soldout:hover {
    background: transparent !important;
    color: #26382f !important;
  }


  .purelane-shop__empty {
    max-width: 600px;
    margin: auto;
    padding: 50px;
    text-align: center;
    border: 1px dashed #999;
    border-radius: 15px;
  }


  @media screen and (max-width: 990px) {

    .purelane-products {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  @media screen and (max-width: 749px) {

    .purelane-shop {
      padding: 60px 20px;
    }

    .purelane-products {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .purelane-product-card__body {
      padding: 14px;
    }

    .purelane-product-card h3 {
      font-size: 15px;
    }

    .purelane-product-card__image img {
      padding: 15px;
    }

  }


  @media screen and (max-width: 480px) {

    .purelane-products {
      grid-template-columns: 1fr;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .purelane-product-card__image img {
      transition: none;
    }

  }

</style>


{% schema %}

{
  "name": "Purelane Product Grid",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }

  ],

  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]

}

{% endschema %}